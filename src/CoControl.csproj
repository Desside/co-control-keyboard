<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>CoControl</RootNamespace>
    <AssemblyName>CoControl</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- CoControl.App is a nested project — keep its sources out of the library glob -->
    <Compile Remove="CoControl.App/**" />
    <None Remove="CoControl.App/**" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CoControl.Tests" />
    <InternalsVisibleTo Include="CoControl.UnitTests" />
    <InternalsVisibleTo Include="S2_RgbTest" />
    <InternalsVisibleTo Include="Diag_DevicePaths" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
</Project>